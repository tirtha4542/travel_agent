# ==============================================================================
# TreapMate AI - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# LLM Provider (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Real-Time Flight Search (AviationStack)
AVIATION_STACK_API_KEY=your_aviationstack_api_key_here
DEFAULT_ORIGIN=DAC

# Real-Time Web Search (Tavily)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# PostgreSQL Database (Optional - falls back to resilient in-memory checkpointer)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# LangSmith Observability (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key_here
LANGSMITH_PROJECT=treapmate_ai

